# Google Analytics 4 — Measurement ID de tu propiedad GA4 (empieza por "G-")
# Se usa en el cliente (por eso lleva el prefijo VITE_).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Telegram — para la alerta instantánea de clicks en el CTA.
# NUNCA lleves el prefijo VITE_ en estas dos: son secretos de servidor,
# usados solo por api/notify.js. Configúralas en Vercel > Project Settings > Environment Variables,
# no en el navegador.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# YouTube — para traer automáticamente los últimos vídeos del canal en la
# sección "Contenido en redes". Secretos de servidor, usados solo por
# api/youtube.js. Configúralas en Vercel, no en el navegador.
# API key: Google Cloud Console > APIs & Services > Credentials (activa antes
# "YouTube Data API v3" en la librería de APIs).
YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Channel ID del canal (empieza por "UC..."), no el @handle.
# Se ve en la URL del canal, o en la sección "Advanced settings" de YouTube Studio.
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
